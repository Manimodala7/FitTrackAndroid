<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2235"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Daily Burn Summary"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w4x2_total_cal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="390 kcal"
            android:textColor="#6EE7B7"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w4x2_steps_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="👟 Steps: 0 / 8000 (0 kcal)"
        android:textColor="#C4B5FD"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w4x2_workout_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="🏋️ 30m Routine + Gym Split: 185 kcal"
        android:textColor="#6EE7B7"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w4x2_water_sleep_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="💧 Water: 0 ml  •  😴 Sleep: 7.5 hrs"
        android:textColor="#93C5FD"
        android:textSize="12sp" />
</LinearLayout>
