<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x3"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E2235"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="FitTrack Friendly Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/w4x3_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Score: 80/100"
            android:textColor="#FDBA74"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w4x3_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="👟 0 steps  |  🔥 185 kcal burned"
        android:textColor="#6EE7B7"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w4x3_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="💧 Water: 0 / 3000 ml   •   😴 Sleep: 7.5 hrs"
        android:textColor="#C4B5FD"
        android:textSize="12sp" />

   <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_widget_water"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:backgroundTint="#60A5FA"
            android:text="💧 +250ml Water"
            android:textColor="#1E2235"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
